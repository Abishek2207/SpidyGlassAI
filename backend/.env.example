# ─────────────────────────────────────────────────────────────────────────────
# SpiderGlass AI – Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="SpiderGlass AI"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-very-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=spiderglass
POSTGRES_PASSWORD=spiderglasspassword
POSTGRES_DB=spiderglass_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://spiderglass:spiderglasspassword@localhost:5432/spiderglass_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── Sarvam AI ────────────────────────────────────────────────────────────────
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_BASE_URL=https://api.sarvam.ai

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
